import random


def main():
    print("Welcome to the Higher/Lower Game!")

    # Step 1: Input validation for bounds
    while True:
        try:
            lower_bound = int(input("Enter the lower bound: "))
            upper_bound = int(input("Enter the upper bound: "))

            if lower_bound < upper_bound:
                break
            else:
                print(
                    "Invalid input: Lower bound must be strictly less than upper bound.\n"
                )
        except ValueError:
            print("Invalid input: Please enter valid integers.\n")

    # Step 2: Generate random target number
    target_number = random.randint(lower_bound, upper_bound)
    is_guessed = False

    # Step 3 & 4: Game loop and decision branching
    while not is_guessed:
        # Input validation for guess
        while True:
            try:
                user_guess = int(
                    input(
                        f"Enter your guess (between {lower_bound} and {upper_bound}): "
                    )
                )
                if lower_bound <= user_guess <= upper_bound:
                    break
                else:
                    print(
                        f"Out of bounds! Guess must be between {lower_bound} and {upper_bound}."
                    )
            except ValueError:
                print("Invalid input: Please enter a valid integer.")

        # Check guess
        if user_guess < target_number:
            print("Higher!\n")
        elif user_guess > target_number:
            print("Lower!\n")
        else:
            print(
                "You got it! Congratulations, you guessed the correct number!"
            )
            is_guessed = True

    print("Thank you for playing!")


if __name__ == "__main__":
    main()
